<Window x:Class="PlantWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlantWidget"
        mc:Ignorable="d"
        Title="Полив цветов"
        Width="300" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Closing="Window_Closing">
    <Grid>
    <Border Background="#EE2B3A28" CornerRadius="10" BorderBrush="#3A5A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="12,10,8,6" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="HeaderTitle" FontSize="15" FontWeight="Bold" Foreground="#E8F0E8" VerticalAlignment="Center"/>
                <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right"
                        Style="{StaticResource PlainIconButtonStyle}"
                        Click="HideButton_Click"/>
            </Grid>

            <!-- Plant list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="6,0,6,0">
                <ItemsControl x:Name="PlantsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#22FFFFFF" CornerRadius="6" Margin="4" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Notes}">
                                        <Grid Width="32" Height="32" Margin="0,0,8,0">
                                            <Ellipse Stroke="#3A5A3A" StrokeThickness="1" Fill="#1FFFFFFF"/>
                                            <Ellipse Stroke="#3A5A3A" StrokeThickness="1">
                                                <Ellipse.Fill>
                                                    <Binding Path="PhotoPath" Converter="{StaticResource PhotoBrushConverter}"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="🌱" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Visibility="{Binding PhotoPath, Converter={StaticResource PhotoPlaceholderVisibilityConverter}}"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Width="30" Height="30" Margin="4,0"
                                            Style="{StaticResource WaterButtonStyle}"
                                            Click="WaterButton_Click" ToolTip="{Binding WaterTooltip}">
                                        <Grid Width="15" Height="15">
                                            <Path x:Name="DropOutline"
                                                  Data="M7,0 C7,0 0,8 0,13 C0,16.87 3.13,20 7,20 C10.87,20 14,16.87 14,13 C14,8 7,0 7,0 Z"
                                                  Stretch="Uniform" Fill="Transparent"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"/>
                                            <Path Data="M7,0 C7,0 0,8 0,13 C0,16.87 3.13,20 7,20 C10.87,20 14,16.87 14,13 C14,8 7,0 7,0 Z"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                <Path.Clip>
                                                    <Binding Path="FillFraction" Converter="{StaticResource FillClipConverter}"/>
                                                </Path.Clip>
                                            </Path>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="2" Content="✎" Width="24" Margin="2,0"
                                            Style="{StaticResource PlainIconButtonStyle}"
                                            Click="EditButton_Click"/>
                                    <Button Grid.Column="3" Content="✕" Width="24"
                                            Style="{StaticResource PlainIconButtonStyle}"
                                            Click="DeleteButton_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="ActionsPanel" Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,4,0,6"
                            Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ActionsPanelTransform" Y="8"/>
                    </StackPanel.RenderTransform>
                    <Button x:Name="SettingsButtonElement" Content="⚙" Style="{StaticResource PanelIconButtonStyle}" FontSize="14" Margin="4,0"
                            Click="SettingsButton_Click"/>
                    <Button x:Name="AddButtonElement" Content="➕" Style="{StaticResource PanelIconButtonStyle}" FontSize="13" Margin="4,0"
                            Click="AddButton_Click"/>
                </StackPanel>

                <Border Grid.Row="1" HorizontalAlignment="Center"
                        BorderBrush="#3A5A3A" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0"
                        Background="#15FFFFFF">
                    <Button x:Name="ToggleActionsButton" Content="▾" Width="72" Height="24"
                            FontSize="14" Padding="0" RenderTransformOrigin="0.5,0.5"
                            Style="{StaticResource PlainIconButtonStyle}"
                            Click="ToggleActionsButton_Click">
                        <Button.RenderTransform>
                            <RotateTransform x:Name="ArrowRotateTransform" Angle="0"/>
                        </Button.RenderTransform>
                    </Button>
                </Border>
            </Grid>
        </Grid>
    </Border>

    <!-- Resize grips, shown only when resizing is enabled in Settings. -->
    <Grid x:Name="ResizeGrips" Visibility="Collapsed">
        <Border Width="6" HorizontalAlignment="Left" Margin="0,10,0,10" Background="Transparent" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Border Width="6" HorizontalAlignment="Right" Margin="0,10,0,10" Background="Transparent" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Border Height="6" VerticalAlignment="Top" Margin="10,0,10,0" Background="Transparent" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Border Height="6" VerticalAlignment="Bottom" Margin="10,0,10,0" Background="Transparent" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
    </Grid>
    </Grid>
</Window>
