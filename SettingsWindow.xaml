<Window x:Class="PlantWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="280" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#EE2B3A28" CornerRadius="10" BorderBrush="#3A5A3A" BorderThickness="1">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="14,10,8,4" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Text="Настройки" FontSize="14" FontWeight="Bold" Foreground="#E8F0E8" VerticalAlignment="Center"/>
                <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right"
                        Style="{StaticResource PlainIconButtonStyle}"
                        Click="Close_Click"/>
            </Grid>

            <StackPanel Margin="16,4,16,16">
                <CheckBox x:Name="AlwaysOnTopBox" Content="Отображать поверх всех окон"
                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,14"
                          Checked="AlwaysOnTopBox_Changed" Unchecked="AlwaysOnTopBox_Changed"/>

                <CheckBox x:Name="AutostartBox" Content="Запускать при старте Windows"
                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,14"
                          Checked="AutostartBox_Changed" Unchecked="AutostartBox_Changed"/>

                <CheckBox x:Name="AllowResizeBox" Content="Разрешить изменение размера окна"
                          Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,18"
                          Checked="AllowResizeBox_Changed" Unchecked="AllowResizeBox_Changed"/>

                <TextBlock Text="Адрес для синхронизации с телефоном" Foreground="#C8D8C8" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="SyncAddressBox" Style="{StaticResource DialogTextBoxStyle}" IsReadOnly="True" Margin="0,0,0,4"/>
                <TextBlock Text="Введите этот адрес в настройках синхронизации мобильного приложения (оба устройства должны быть в одной Wi-Fi сети)."
                           Foreground="#6E7D6E" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,18"/>

                <Button Content="Закрыть" Style="{StaticResource DialogButtonStyle}" HorizontalAlignment="Right" Click="Close_Click"/>

                <TextBlock x:Name="VersionText" Foreground="#6E7D6E" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
