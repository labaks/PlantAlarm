<Window x:Class="PlantWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="280" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#EE2B3A28" CornerRadius="10" BorderBrush="#3A5A3A" BorderThickness="1">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="14,10,8,4" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" Foreground="#E8F0E8" VerticalAlignment="Center"/>
                <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right"
                        Style="{StaticResource PlainIconButtonStyle}"
                        Click="Close_Click"/>
            </Grid>

            <StackPanel Margin="16,4,16,16">
                <CheckBox x:Name="AlwaysOnTopBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,14"
                          Checked="AlwaysOnTopBox_Changed" Unchecked="AlwaysOnTopBox_Changed"/>

                <CheckBox x:Name="AutostartBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,14"
                          Checked="AutostartBox_Changed" Unchecked="AutostartBox_Changed"/>

                <CheckBox x:Name="AllowResizeBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,14"
                          Checked="AllowResizeBox_Changed" Unchecked="AllowResizeBox_Changed"/>

                <CheckBox x:Name="SoundBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,18"
                          Checked="SoundBox_Changed" Unchecked="SoundBox_Changed"/>

                <TextBlock x:Name="LanguageLabel" Foreground="#C8D8C8" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="LanguageComboBox" Style="{StaticResource DialogComboBoxStyle}" Margin="0,0,0,18"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem x:Name="LanguageRuItem" Content="Русский" Tag="ru"/>
                    <ComboBoxItem x:Name="LanguageEnItem" Content="English" Tag="en"/>
                </ComboBox>

                <TextBlock x:Name="SyncAddressLabel" Foreground="#C8D8C8" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="SyncAddressBox" Style="{StaticResource DialogTextBoxStyle}" IsReadOnly="True" Margin="0,0,0,4"/>
                <TextBlock x:Name="SyncAddressHint"
                           Foreground="#6E7D6E" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,18"/>

                <TextBlock x:Name="BackupLabel" Foreground="#C8D8C8" FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="ExportButtonElement" Style="{StaticResource DialogButtonStyle}" Margin="0,0,8,0" Click="ExportButton_Click"/>
                    <Button x:Name="ImportButtonElement" Style="{StaticResource DialogButtonStyle}" Click="ImportButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="BackupStatusText" Foreground="#7CB97C" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" Visibility="Collapsed"/>

                <Button x:Name="CloseButtonElement" Style="{StaticResource DialogButtonStyle}" HorizontalAlignment="Right" Click="Close_Click"/>

                <TextBlock x:Name="VersionText" Foreground="#6E7D6E" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
