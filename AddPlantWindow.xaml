<Window x:Class="PlantWidget.AddPlantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Цветок" Width="280" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#EE2B3A28" CornerRadius="10" BorderBrush="#3A5A3A" BorderThickness="1">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="14,10,8,4" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock x:Name="TitleText" Text="Цветок" FontSize="14" FontWeight="Bold" Foreground="#E8F0E8" VerticalAlignment="Center"/>
                <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right"
                        Style="{StaticResource PlainIconButtonStyle}"
                        Click="Cancel_Click"/>
            </Grid>

            <StackPanel Margin="16,4,16,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Grid Width="48" Height="48" Margin="0,0,10,0">
                        <Ellipse Stroke="#3A5A3A" StrokeThickness="1" Fill="#1FFFFFFF"/>
                        <Ellipse x:Name="PhotoCircle" Stroke="#3A5A3A" StrokeThickness="1"/>
                        <TextBlock x:Name="PhotoPlaceholder" Text="🌱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <Button x:Name="ChoosePhotoButton" Style="{StaticResource DialogButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,0,0,4" Click="ChoosePhoto_Click"/>
                        <Button x:Name="RemovePhotoButton" Style="{StaticResource PlainIconButtonStyle}"
                                Foreground="#8FA08F" FontSize="11" HorizontalAlignment="Left" Padding="0"
                                Visibility="Collapsed" Click="RemovePhoto_Click"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="NameLabel" Foreground="#C8D8C8" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Style="{StaticResource DialogTextBoxStyle}" Margin="0,0,0,12"/>

                <TextBlock x:Name="IntervalLabel" Foreground="#C8D8C8" Margin="0,0,0,4"/>
                <TextBox x:Name="IntervalBox" Style="{StaticResource DialogTextBoxStyle}" Margin="0,0,0,12"/>

                <StackPanel x:Name="DaysAgoPanel" Margin="0,0,0,8">
                    <TextBlock x:Name="DaysAgoLabel" Foreground="#C8D8C8" Margin="0,0,0,4"/>
                    <TextBox x:Name="DaysAgoBox" Style="{StaticResource DialogTextBoxStyle}"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#E0917B" FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,8" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButtonElement" Style="{StaticResource DialogButtonStyle}" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="SaveButtonElement" Style="{StaticResource DialogButtonStyle}" Click="Save_Click" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
